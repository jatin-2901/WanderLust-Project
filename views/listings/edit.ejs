<% layout("/layouts/boilerplate") -%>
<body>
    <h1 style="text-align: center;"><b>Edit Listing</b> - ID : <%= listings._id %></h1>
   
    <div class="row">
    <div class="col-8 offset-2">
      <form action="/listings/<%= listings._id %>?_method=PATCH" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">

        <div class="mb-3">
          <label for="title" class="form-label"></label>
          <input
            name="listing[title]"
            id="title"
            rows="5"
            cols="30"
            class="form-control"
            placeholder="Enter a Catchy Title"
            value="<%= listings.title %>"
            required
          />
          <div class="invalid-feedback">Enter Title!</div>
        </div>

        <div class="mb-3">
          <label for="desc" class="form-label">Description</label>
          <textarea
             name="listing[description]"
            id="desc"
            rows="5"
            cols="50"
            class="form-control"
            placeholder="Description"
            required
          ><%= listings.description %></textarea>
          <div class="invalid-feedback">Description should be valid</div>
        </div>

        <div class="mb-3">
          <b>Uploaded Image</b> <br>
          <img src="<%= originalListingUrl %>"  style="max-width: 200px; height: auto;" >
        </div>

        <!-- style="height: 250px; width: 250x;" -->

        <div class="mb-3">
          <label for="img" class="form-label">Upload Image</label>
          <input
            name="listing[image][url]"
            id="img"
            class="form-control"
            type="file"
          />
        </div>

        <div class="mb-3">
          <label for="category" class="form-label">Category</label>
          <select class="form-select" aria-label="Default select example" id="category" name="listing[category]" required>
            <option value="<%= listings.category %>"><%= listings.category %></option>
            <option value="arctic">arctic</option>
            <option value="farms">farms</option>
            <option value="photography">photography</option>
            <option value="beach">beach</option>
            <option value="yacht">yacht</option>
            <option value="cabins">cabins</option>
            <option value="foreign">foreign</option>
            <option value="castles">castles</option>
            <option value="domes">domes</option>
            <option value="room">room</option>
            <option value="monuments">monuments</option>
          </select>
          <div class="invalid-feedback">Please choose a category</div>
        </div>

        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="location" class="form-label">Location</label>
            <input
               name="listing[location]"
              id="location"
              rows="3"
              cols="20"
              class="form-control"
              placeholder="Jaipur, Rajasthan"
              value="<%= listings.location %>"
              required
            />
            <div class="invalid-feedback">location should be valid</div>
          </div>

          <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input
              name="listing[country]"
              id="country"
              rows="3"
              cols="20"
              class="form-control"
              placeholder="India"
              value="<%= listings.country %>"
              required
            />
            <div class="invalid-feedback">Country name should be valid</div>
          </div>
        </div>

        <div class="mb-3">
          <label for="price" class="form-label">Price</label>

          <input
            type="number"
           name="listing[price]"
            id="price"
            rows="3"
            cols="20"
            class="form-control"
            placeholder="6000"
            value="<%= listings.price %>"
            required
          />
          <div class="invalid-feedback">Price should be valid</div>
        </div>

        <br />
        <br />

        <button class="btn btn-dark btn-add">Add</button>
        <br /><br />
      </form>
    </div>
  </div>
   
</body>

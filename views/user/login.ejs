<% layout("/layouts/boilerplate") -%>
<body>
  <div class="row mt-3">
    <h1 class="col-6 offset-3 mt-3">Login on WanderLust</h1>
    <div class="col-6 offset-3 mt-3">
      <form action="/login" method="POST" class="needs-validation" novalidate>
        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <input
            name="username"
            id="username"
            rows="5"
            cols="30"
            class="form-control"
            required
          />
        </div>

        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <input
            name="password"
            id="password"
            type="password"
            rows="5"
            cols="30"
            class="form-control"
            required
          />
        </div>
        <button class="btn btn-outline-dark mt-3">Login</button>
        <h6 class="mt-3">Don't have an account, <a href="http://localhost:3000/signUp" style="text-decoration: none;">SignUp</a></h6>
      </form>
    </div>
  </div>
</body>
